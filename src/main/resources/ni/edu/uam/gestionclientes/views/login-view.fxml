<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.gestionclientes.controllers.LoginController"
      styleClass="root-pane" prefWidth="380.0" prefHeight="320.0">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="Sistema de Gestión de Clientes" styleClass="title-label"/>
    <Label text="Inicie sesión para continuar"/>

    <VBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Usuario"/>
        <TextField fx:id="txtUsername" promptText="admin"/>
    </VBox>

    <VBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Contraseña"/>
        <PasswordField fx:id="pfPassword" promptText="admin123" onKeyPressed="#onPasswordKeyPressed"/>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Button fx:id="btnLogin" text="Ingresar" onAction="#onLoginAction" defaultButton="true"/>
        <Button fx:id="btnExit" text="Salir" onAction="#onExitAction" cancelButton="true"/>
    </HBox>
</VBox>
