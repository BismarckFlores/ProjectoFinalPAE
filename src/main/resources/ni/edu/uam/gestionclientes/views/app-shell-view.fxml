<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.gestionclientes.controllers.AppShellController"
            prefWidth="960.0" prefHeight="640.0">

    <fx:define>
        <ContextMenu fx:id="contextMenu">
            <items>
                <MenuItem fx:id="contextItemRegistro" text="Registrar Cliente" onAction="#onMenuRegistroClick"/>
                <MenuItem fx:id="contextItemConsulta" text="Consultar Clientes" onAction="#onMenuConsultaClick"/>
                <MenuItem fx:id="contextItemInfo" text="Información" onAction="#onContextInfoClick"/>
            </items>
        </ContextMenu>
    </fx:define>

    <top>
        <VBox>
            <MenuBar fx:id="menuBar">
                <Menu text="Menú">
                    <MenuItem fx:id="menuRegistro" text="Registrar Cliente" onAction="#onMenuRegistroClick"/>
                    <MenuItem fx:id="menuConsulta" text="Consultar Clientes" onAction="#onMenuConsultaClick"/>
                    <MenuItem fx:id="menuCerrarSesion" text="Cerrar Sesión" onAction="#onCerrarSesionClick"/>
                    <MenuItem fx:id="menuSalir" text="Salir" onAction="#onSalirClick"/>
                </Menu>
                <Menu text="Administración">
                    <MenuItem fx:id="menuAdminPanel" text="Panel de Administración" onAction="#onAdminPanelClick"/>
                </Menu>
                <Menu text="Ayuda">
                    <MenuItem fx:id="menuAcercaDe" text="Acerca De" onAction="#onAcercaDeClick"/>
                </Menu>
            </MenuBar>
            <ToolBar fx:id="toolBar">
                <Button fx:id="btnToolBarRegistro" onAction="#onMenuRegistroClick" styleClass="icon-button">
                    <graphic>
                        <SVGPath styleClass="icon-shape" scaleX="0.65" scaleY="0.65"
                                 content="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M15,12C17.21,12 19,10.21 19,8C19,5.79 17.21,4 15,4C12.79,4 11,5.79 11,8C11,10.21 12.79,12 15,12M6,10V7H4V10H1V12H4V15H6V12H9V10H6Z"/>
                    </graphic>
                    <tooltip><Tooltip text="Registrar Cliente"/></tooltip>
                </Button>
                <Button fx:id="btnToolBarConsulta" onAction="#onMenuConsultaClick" styleClass="icon-button">
                    <graphic>
                        <SVGPath styleClass="icon-shape" scaleX="0.65" scaleY="0.65"
                                 content="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.49L20.49,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z"/>
                    </graphic>
                    <tooltip><Tooltip text="Consultar Clientes"/></tooltip>
                </Button>
                <Button fx:id="btnToolBarAdminPanel" onAction="#onAdminPanelClick" styleClass="icon-button">
                    <graphic>
                        <SVGPath styleClass="icon-shape" scaleX="0.65" scaleY="0.65"
                                 content="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.53,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.72,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.72,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.53,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                    </graphic>
                    <tooltip><Tooltip text="Panel de Administración"/></tooltip>
                </Button>
                <Button fx:id="btnToolBarCerrarSesion" onAction="#onCerrarSesionClick" styleClass="icon-button">
                    <graphic>
                        <SVGPath styleClass="icon-shape" scaleX="0.65" scaleY="0.65"
                                 content="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z"/>
                    </graphic>
                    <tooltip><Tooltip text="Cerrar Sesión"/></tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="root-pane">
            <VBox fx:id="homePane" alignment="CENTER" spacing="18.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <VBox styleClass="brand-badge" alignment="CENTER">
                    <Label text="GC" styleClass="brand-badge-text"/>
                </VBox>

                <Label fx:id="lblBienvenida" text="Bienvenido al Sistema de Gestión de Clientes" styleClass="title-label"/>
                <Label fx:id="lblEstado" styleClass="subtitle-label"/>
                <Label text="Clic derecho aquí para el menú contextual" styleClass="subtitle-label"/>

                <HBox spacing="12.0" alignment="CENTER">
                    <Button fx:id="btnRegistrarCliente" text="Registrar Cliente" onAction="#onMenuRegistroClick"/>
                    <Button fx:id="btnConsultarClientes" text="Consultar Clientes" onAction="#onMenuConsultaClick"/>
                    <Button fx:id="btnAdminPanel" text="Panel de Administración" onAction="#onAdminPanelClick" styleClass="button-secondary"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
