<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.gestionclientes.controllers.AccountCreateController"
      styleClass="root-pane">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Nueva Cuenta de Usuario" styleClass="title-label"/>

    <GridPane hgap="10.0" vgap="10.0" maxWidth="420.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints minWidth="200.0"/>
        </columnConstraints>

        <Label text="Usuario" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNewUsername" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Contraseña" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="pfNewPassword" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Rol" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbRole" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="15.0" alignment="CENTER">
        <Button text="Guardar" onAction="#onSaveAction" defaultButton="true"/>
        <Button text="Cancelar" onAction="#onCancelAction" cancelButton="true"/>
    </HBox>
</VBox>
