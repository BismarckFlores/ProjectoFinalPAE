<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.gestionclientes.controllers.AdminPanelController"
      styleClass="root-pane">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <VBox styleClass="card" spacing="14.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0"/>
        </padding>

        <Label text="Panel de Administración" styleClass="title-label"/>
        <Label text="Cuentas registradas en el sistema" styleClass="subtitle-label"/>

        <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colUsername" text="Usuario" prefWidth="180.0"/>
                <TableColumn fx:id="colRole" text="Rol" prefWidth="160.0"/>
                <TableColumn fx:id="colActive" text="Activo" prefWidth="80.0"/>
            </columns>
        </TableView>

        <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <Button text="Volver al Menú" onAction="#onBackAction" styleClass="button-secondary" cancelButton="true"/>
            <Button text="Eliminar Cuenta" onAction="#onDeleteAccountAction" styleClass="button-danger"/>
            <Button text="Nueva Cuenta" onAction="#onNewAccountAction"/>
        </HBox>
    </VBox>
</VBox>
