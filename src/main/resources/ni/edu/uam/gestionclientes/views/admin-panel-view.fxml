<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.gestionclientes.controllers.AdminPanelController"
      prefWidth="560.0" prefHeight="420.0" styleClass="root-pane">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Panel de Administración" styleClass="title-label"/>
    <Label text="Cuentas registradas en el sistema"/>

    <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="180.0"/>
            <TableColumn fx:id="colRole" text="Rol" prefWidth="160.0"/>
            <TableColumn fx:id="colActive" text="Activo" prefWidth="80.0"/>
        </columns>
    </TableView>

    <HBox spacing="15.0" alignment="CENTER">
        <Button text="Nueva Cuenta" onAction="#onNewAccountAction"/>
        <Button text="Eliminar Cuenta" onAction="#onDeleteAccountAction"/>
        <Button text="Volver al Menú" onAction="#onBackAction" cancelButton="true"/>
    </HBox>
</VBox>
